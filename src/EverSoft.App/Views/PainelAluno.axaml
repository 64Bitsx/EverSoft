<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:EverSoft.App.ViewModels"
             x:Class="EverSoft.App.Views.PainelAluno"
             x:DataType="vm:PainelAlunoVM">
  <UserControl.Styles>
    <Style Selector="Grid.info">
      <Setter Property="Margin" Value="0,0,0,10"/>
    </Style>
    <Style Selector="Border.ic">
      <Setter Property="Width" Value="32"/><Setter Property="Height" Value="32"/><Setter Property="CornerRadius" Value="10"/>
      <Setter Property="Background" Value="{DynamicResource Superficie2}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Borda}"/><Setter Property="BorderThickness" Value="1"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style Selector="Border.ic PathIcon">
      <Setter Property="Width" Value="15"/><Setter Property="Height" Value="15"/><Setter Property="Foreground" Value="{DynamicResource Primaria}"/>
    </Style>
    <Style Selector="SelectableTextBlock.v, TextBlock.v">
      <Setter Property="FontWeight" Value="SemiBold"/><Setter Property="FontSize" Value="13.5"/>
      <Setter Property="Foreground" Value="{DynamicResource Texto}"/><Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style Selector="TextBlock.r">
      <Setter Property="FontSize" Value="10"/><Setter Property="FontWeight" Value="Bold"/><Setter Property="LetterSpacing" Value="0.6"/>
      <Setter Property="Foreground" Value="{DynamicResource TextoSuave}"/>
    </Style>
  </UserControl.Styles>

  <Border Classes="cartao" Padding="0" ClipToBounds="True">
    <DockPanel>
      <!-- Faixa colorida com a foto -->
      <Grid DockPanel.Dock="Top" Height="250">
        <Border Height="96" VerticalAlignment="Top">
          <Border.Background>
            <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
              <GradientStop Color="#0B1B33" Offset="0"/>
              <GradientStop Color="#0D9488" Offset="1"/>
            </LinearGradientBrush>
          </Border.Background>
        </Border>
        <Border Width="150" Height="180" CornerRadius="18" Background="{DynamicResource FotoFundo}" ClipToBounds="True"
                VerticalAlignment="Bottom" HorizontalAlignment="Center" BorderBrush="{DynamicResource Superficie}" BorderThickness="4"
                BoxShadow="0 6 18 0 #330F172A">
          <Grid>
            <PathIcon Data="{StaticResource IcPessoa}" Width="64" Height="64" Foreground="{DynamicResource BordaForte}"
                      IsVisible="{Binding Foto, Converter={x:Static ObjectConverters.IsNull}}"/>
            <Image Source="{Binding Foto}" Stretch="UniformToFill"/>
            <TextBlock Text="{Binding AvisoFoto}" FontSize="11" Foreground="{DynamicResource TextoSuave}" HorizontalAlignment="Center"
                       VerticalAlignment="Bottom" Margin="0,0,0,10"/>
          </Grid>
        </Border>
      </Grid>

      <StackPanel Margin="20,14,20,20" Spacing="0">
        <TextBlock Text="{Binding Nome}" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource Texto}" TextWrapping="Wrap"
                   TextAlignment="Center" HorizontalAlignment="Center"/>
        <Border Background="{Binding FundoSituacao}" CornerRadius="999" Padding="12,3" HorizontalAlignment="Center" Margin="0,8,0,18"
                IsVisible="{Binding TemAluno}">
          <TextBlock Text="{Binding Situacao}" Foreground="{Binding TextoSituacao}" FontWeight="Bold" FontSize="11" LetterSpacing="0.6"/>
        </Border>

        <Grid Classes="info" ColumnDefinitions="Auto,*">
          <Border Classes="ic"><PathIcon Data="{StaticResource IcCartao}"/></Border>
          <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center"><TextBlock Classes="r" Text="MATRÍCULA"/><SelectableTextBlock Classes="v" Text="{Binding Matricula}"/></StackPanel>
        </Grid>
        <Grid Classes="info" ColumnDefinitions="Auto,*">
          <Border Classes="ic"><PathIcon Data="{StaticResource IcLivro}"/></Border>
          <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center"><TextBlock Classes="r" Text="MATÉRIA"/><TextBlock Classes="v" Text="{Binding Materia}"/></StackPanel>
        </Grid>
        <Grid Classes="info" ColumnDefinitions="Auto,*">
          <Border Classes="ic"><PathIcon Data="{StaticResource IcRelogio}"/></Border>
          <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center"><TextBlock Classes="r" Text="ÚLTIMA AULA"/><TextBlock Classes="v" Text="{Binding Ultima}"/></StackPanel>
        </Grid>
        <Border Height="1" Background="{DynamicResource Borda}" Margin="0,2,0,12"/>
        <Grid Classes="info" ColumnDefinitions="Auto,*">
          <Border Classes="ic"><PathIcon Data="{StaticResource IcTelefone}"/></Border>
          <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center" Spacing="2">
            <TextBlock Classes="r" Text="TELEFONES"/>
            <SelectableTextBlock Classes="v" Text="{Binding Tel1}"/>
            <SelectableTextBlock Classes="v" Text="{Binding Tel2}"/>
            <SelectableTextBlock Classes="v" Text="{Binding Tel3}"/>
          </StackPanel>
        </Grid>
        <Grid Classes="info" ColumnDefinitions="Auto,*">
          <Border Classes="ic"><PathIcon Data="{StaticResource IcCamera}"/></Border>
          <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center"><TextBlock Classes="r" Text="INSTAGRAM"/><SelectableTextBlock Classes="v" Text="{Binding Insta}"/></StackPanel>
        </Grid>

        <Button Classes="primaria" Command="{Binding CopiarContatosCommand}" IsEnabled="{Binding TemAluno}"
                HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Padding="10,10" Margin="0,8,0,0">
          <StackPanel Orientation="Horizontal" Spacing="8"><PathIcon Data="{StaticResource IcCopiar}"/><TextBlock Text="Copiar nome e telefones"/></StackPanel>
        </Button>
      </StackPanel>
    </DockPanel>
  </Border>
</UserControl>
