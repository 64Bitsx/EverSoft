<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:EverSoft.App.ViewModels"
             x:Class="EverSoft.App.Views.MsgView"
             x:DataType="vm:MsgVM">
  <ScrollViewer>
    <StackPanel Spacing="8" MaxWidth="900" HorizontalAlignment="Left">
    <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,0,0,8">
      <Border Width="46" Height="46" CornerRadius="14" Background="{DynamicResource Primaria}">
        <PathIcon Data="{StaticResource IcMensagem}" Width="22" Height="22" Foreground="{DynamicResource PrimariaTexto}"/>
      </Border>
      <StackPanel VerticalAlignment="Center" Spacing="2">
        <TextBlock Classes="titulo" Text="MSG"/>
        <TextBlock Classes="subtitulo" Text="Aviso / feriado para disparo em massa"/>
      </StackPanel>
    </StackPanel>
      <Border Classes="cartao">
        <StackPanel Spacing="6">
          <TextBlock Classes="rotulo" Text="B1 · MENSAGEM DE ABERTURA"/>
          <TextBox Text="{Binding B1}" AcceptsReturn="True" TextWrapping="Wrap" Height="80"/>
          <TextBlock Classes="rotulo" Text="B2 · MENSAGEM FINAL" Margin="0,6,0,0"/>
          <TextBox Text="{Binding B2}" AcceptsReturn="True" TextWrapping="Wrap" Height="80"/>
          <TextBlock Classes="rotulo" Text="B3 · RESERVA" Margin="0,6,0,0"/>
          <TextBox Text="{Binding B3}" AcceptsReturn="True" TextWrapping="Wrap" Height="80"/>
          <TextBlock Classes="rotulo" Text="IMAGEM (CAMINHO)" Margin="0,6,0,0"/>
          <TextBox Text="{Binding Imagem}"/>
          <Button Classes="primaria" Command="{Binding SalvarCommand}" Margin="0,10,0,0" HorizontalAlignment="Left"><StackPanel Orientation="Horizontal" Spacing="8"><PathIcon Data="{StaticResource IcSalvar}"/><TextBlock Text="Salvar"/></StackPanel></Button>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
