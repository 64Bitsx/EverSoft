<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:EverSoft.App.ViewModels"
             x:Class="EverSoft.App.Views.SlotView"
             x:DataType="vm:SlotVM">
  <UserControl.Styles>
    <!-- Cartões de resumo -->
    <Style Selector="Border.resumo">
      <Setter Property="Background" Value="{DynamicResource Superficie}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Borda}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="14"/>
      <Setter Property="Padding" Value="16,12"/>
      <Setter Property="BoxShadow" Value="0 2 10 0 #140F172A"/>
    </Style>
    <Style Selector="Border.resumo TextBlock.numero">
      <Setter Property="FontSize" Value="24"/><Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="Foreground" Value="{DynamicResource Texto}"/>
    </Style>
    <Style Selector="Border.icone">
      <Setter Property="Width" Value="40"/><Setter Property="Height" Value="40"/><Setter Property="CornerRadius" Value="12"/>
    </Style>
    <Style Selector="Border.icone PathIcon">
      <Setter Property="Width" Value="20"/><Setter Property="Height" Value="20"/>
    </Style>
  </UserControl.Styles>

  <DockPanel>
    <!-- Título da turma -->
    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,16">
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
        <Button Classes="dourado" Command="{Binding LembretesCommand}" ToolTip.Tip="Monta a Agenda e envia os lembretes pelo WhatsApp">
          <StackPanel Orientation="Horizontal" Spacing="8"><PathIcon Data="{StaticResource IcSino}"/><TextBlock Text="Enviar lembretes"/></StackPanel>
        </Button>
        <Button Classes="primaria" Command="{Binding PreencheJustificadosCommand}" ToolTip.Tip="Leva para a Justifica quem faltou hoje">
          <StackPanel Orientation="Horizontal" Spacing="8"><PathIcon Data="{StaticResource IcPrancheta}"/><TextBlock Text="Preenche justificados"/></StackPanel>
        </Button>
      </StackPanel>
      <StackPanel Orientation="Horizontal" Spacing="12">
        <Border Width="46" Height="46" CornerRadius="14" Background="{Binding Cor}">
          <PathIcon Data="{StaticResource IcRelogio}" Width="22" Height="22" Foreground="White"/>
        </Border>
        <StackPanel VerticalAlignment="Center" Spacing="2">
          <StackPanel Orientation="Horizontal" Spacing="10">
            <TextBlock Classes="titulo" Text="{Binding Nome}" VerticalAlignment="Center"/>
            <Border Background="{DynamicResource PrimariaSuave}" CornerRadius="999" Padding="10,3" VerticalAlignment="Center">
              <TextBlock Text="{Binding Tipo}" FontSize="10.5" FontWeight="Bold" LetterSpacing="0.8" Foreground="{DynamicResource Primaria}"/>
            </Border>
          </StackPanel>
          <TextBlock Classes="subtitulo" Text="Clique duplo na matrícula para editar · botão direito abre o menu do aluno"/>
        </StackPanel>
      </StackPanel>
    </DockPanel>

    <!-- Cartões de resumo -->
    <UniformGrid DockPanel.Dock="Top" Columns="4" Margin="0,0,0,16">
      <Border Classes="resumo" Margin="0,0,8,0">
        <StackPanel Orientation="Horizontal" Spacing="14">
          <Border Classes="icone" Background="#1A0D9488"><PathIcon Data="{StaticResource IcMonitor}" Foreground="#0D9488"/></Border>
          <StackPanel VerticalAlignment="Center">
            <TextBlock Classes="rotulo" Text="PCS EM USO"/>
            <StackPanel Orientation="Horizontal" Spacing="4">
              <TextBlock Classes="numero" Text="{Binding QtdUsados}"/>
              <TextBlock Text="{Binding TotalPcs, StringFormat='/ {0}'}" FontSize="14" Foreground="{DynamicResource TextoSuave}" VerticalAlignment="Bottom" Margin="0,0,0,4"/>
            </StackPanel>
          </StackPanel>
        </StackPanel>
      </Border>
      <Border Classes="resumo" Margin="4,0">
        <StackPanel Orientation="Horizontal" Spacing="14">
          <Border Classes="icone" Background="#1FEA580C"><PathIcon Data="{StaticResource IcAlerta}" Foreground="#EA580C"/></Border>
          <StackPanel VerticalAlignment="Center">
            <TextBlock Classes="rotulo" Text="SEM STATUS"/>
            <TextBlock Classes="numero" Text="{Binding QtdSemStatus}"/>
          </StackPanel>
        </StackPanel>
      </Border>
      <Border Classes="resumo" Margin="4,0">
        <StackPanel Orientation="Horizontal" Spacing="14">
          <Border Classes="icone" Background="#1FE5383B"><PathIcon Data="{StaticResource IcAusente}" Foreground="#E5383B"/></Border>
          <StackPanel VerticalAlignment="Center">
            <TextBlock Classes="rotulo" Text="+30 DIAS SEM VIR"/>
            <TextBlock Classes="numero" Text="{Binding QtdSumidos}"/>
          </StackPanel>
        </StackPanel>
      </Border>
      <Border Classes="resumo" Margin="8,0,0,0">
        <StackPanel Orientation="Horizontal" Spacing="14">
          <Border Classes="icone" Background="#1F16A34A"><PathIcon Data="{StaticResource IcEstrela}" Foreground="#16A34A"/></Border>
          <StackPanel VerticalAlignment="Center">
            <TextBlock Classes="rotulo" Text="COM COMENTÁRIO"/>
            <TextBlock Classes="numero" Text="{Binding QtdComentario}"/>
          </StackPanel>
        </StackPanel>
      </Border>
    </UniformGrid>

    <!-- Barra de ações -->
    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
      <WrapPanel Orientation="Horizontal" ItemSpacing="8" LineSpacing="8">
        <Button Command="{Binding StatusCommand}">
          <StackPanel Orientation="Horizontal" Spacing="8"><PathIcon Data="{StaticResource IcBandeira}" Foreground="#F59E0B"/><TextBlock Text="Status"/></StackPanel>
        </Button>
        <Button Command="{Binding JustificarCommand}" ToolTip.Tip="Justificativa de falta (J)">
          <StackPanel Orientation="Horizontal" Spacing="8"><PathIcon Data="{StaticResource IcAlunoOk}" Foreground="#2563EB"/><TextBlock Text="Justificar"/></StackPanel>
        </Button>
        <Button Command="{Binding ComentsCommand}">
          <StackPanel Orientation="Horizontal" Spacing="8"><PathIcon Data="{StaticResource IcComentario}" Foreground="#16A34A"/><TextBlock Text="Coments"/></StackPanel>
        </Button>
        <Button Command="{Binding BloqueioCommand}">
          <StackPanel Orientation="Horizontal" Spacing="8"><PathIcon Data="{StaticResource IcCadeado}" Foreground="#E5383B"/><TextBlock Text="Bloqueio"/></StackPanel>
        </Button>
        <Button Command="{Binding InfoCommand}">
          <StackPanel Orientation="Horizontal" Spacing="8"><PathIcon Data="{StaticResource IcInfo}" Foreground="#7C3AED"/><TextBlock Text="Info"/></StackPanel>
        </Button>
        <Button Command="{Binding AbrirSistemaCommand}">
          <StackPanel Orientation="Horizontal" Spacing="8"><PathIcon Data="{StaticResource IcGlobo}" Foreground="#0EA5E9"/><TextBlock Text="Sistema Escola"/></StackPanel>
        </Button>
      </WrapPanel>
    </DockPanel>

    <!-- Tabela dos 19 PCs -->
    <Border Classes="cartao" Padding="0" ClipToBounds="True">
    <DataGrid x:Name="Grade" ItemsSource="{Binding Linhas}" SelectedItem="{Binding Selecionada}"
              AutoGenerateColumns="False" CanUserSortColumns="False" CanUserReorderColumns="False"
              SelectionMode="Single" RowHeight="32" HorizontalScrollBarVisibility="Auto" HeadersVisibility="Column">
      <DataGrid.Styles>
        <!-- Aluno sem status: a linha inteira fica laranja -->
        <Style Selector="DataGridRow" x:DataType="vm:LinhaVM">
          <Setter Property="Background" Value="{Binding FundoLinha}"/>
        </Style>
        <Style Selector="DataGridRow:selected /template/ Rectangle#BackgroundRectangle" x:DataType="vm:LinhaVM">
          <Setter Property="Fill" Value="{Binding FundoSelecionado}"/>
        </Style>
        <Style Selector="Button.sistema">
          <Setter Property="Padding" Value="0"/><Setter Property="Width" Value="30"/><Setter Property="Height" Value="24"/>
          <Setter Property="Background" Value="{DynamicResource PrimariaSuave}"/><Setter Property="CornerRadius" Value="8"/><Setter Property="BorderThickness" Value="0"/>
          <Setter Property="HorizontalContentAlignment" Value="Center"/><Setter Property="VerticalContentAlignment" Value="Center"/>
          <Setter Property="HorizontalAlignment" Value="Center"/><Setter Property="FontSize" Value="14"/>
        </Style>
      </DataGrid.Styles>
      <DataGrid.ContextMenu>
        <ContextMenu>
          <MenuItem Header="Informações do aluno" Command="{Binding InfoCommand}"/>
          <MenuItem Header="Status..." Command="{Binding StatusCommand}"/>
          <MenuItem Header="Justificativa (J)..." Command="{Binding JustificarCommand}"/>
          <MenuItem Header="Coments..." Command="{Binding ComentsCommand}"/>
          <MenuItem Header="Bloqueio..." Command="{Binding BloqueioCommand}"/>
          <Separator/>
          <MenuItem Header="Marcar / desmarcar J" Command="{Binding AlternarJCommand}"/>
          <MenuItem Header="Copiar nome" Command="{Binding CopiarNomeCommand}"/>
          <MenuItem Header="Abrir no Sistema Escola" Command="{Binding AbrirSistemaCommand}"/>
        </ContextMenu>
      </DataGrid.ContextMenu>
      <DataGrid.Columns>
        <DataGridTextColumn Header="PC" Binding="{Binding Pc}" IsReadOnly="True" Width="40"/>
        <DataGridCheckBoxColumn Header="J" Binding="{Binding J}" Width="40"/>
        <DataGridTemplateColumn Header="" Width="40" IsReadOnly="True">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate x:DataType="vm:LinhaVM">
              <Button Classes="sistema" ToolTip.Tip="Abrir a conta do aluno no Sistema Escola"
                      Command="{Binding AbrirSistemaCommand}" IsVisible="{Binding !Vazia}">
                <PathIcon Data="{StaticResource IcGlobo}" Width="14" Height="14" Foreground="{DynamicResource Primaria}"/>
              </Button>
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
        <DataGridTextColumn Header="MATRÍC." Binding="{Binding Matricula}" Width="96" FontWeight="Bold"/>
        <DataGridTextColumn Header="NOME" Binding="{Binding Nome}" IsReadOnly="True" Width="SizeToCells" MinWidth="160"/>
        <DataGridTextColumn Header="MATÉRIA" Binding="{Binding Materia}" IsReadOnly="True" Width="SizeToCells" MinWidth="90"/>
        <DataGridTextColumn Header="AULA" Binding="{Binding Aula}" IsReadOnly="True" Width="SizeToCells" MinWidth="74"/>
        <DataGridTemplateColumn Header="ÚLTIMA" Width="SizeToCells" MinWidth="96" IsReadOnly="True">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate x:DataType="vm:LinhaVM">
              <Panel>
                <TextBlock Text="{Binding Ultima}" VerticalAlignment="Center" Margin="12,0" IsVisible="{Binding !UltimaVermelha}"/>
                <Border Classes="pilula" Background="#E5383B" IsVisible="{Binding UltimaVermelha}">
                  <TextBlock Text="{Binding Ultima}" Foreground="White" FontWeight="SemiBold" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                </Border>
              </Panel>
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
        <DataGridTextColumn Header="A PAGAR" Binding="{Binding APagar}" IsReadOnly="True" Width="SizeToCells" MinWidth="64"/>
        <DataGridTemplateColumn Header="SIT" Width="96" IsReadOnly="True">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate x:DataType="vm:LinhaVM">
              <Border Classes="pilula" Background="{Binding FundoSit}">
                <TextBlock Text="{Binding Sit}" Foreground="{Binding TextoSit}" FontWeight="SemiBold" VerticalAlignment="Center" HorizontalAlignment="Center"/>
              </Border>
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
        <DataGridTextColumn Header="INÍCIO" Binding="{Binding Inicio}" IsReadOnly="True" Width="SizeToCells" MinWidth="80"/>
        <DataGridTemplateColumn Header="COMENTÁRIO" Width="118" IsReadOnly="True">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate x:DataType="vm:LinhaVM">
              <Border Classes="pilula" Background="#16A34A" IsVisible="{Binding TemComentario}">
                <StackPanel Orientation="Horizontal" Spacing="5" HorizontalAlignment="Center">
                  <PathIcon Data="{StaticResource IcEstrela}" Width="11" Height="11" Foreground="White"/>
                  <TextBlock Text="SIM" Foreground="White" FontWeight="Bold" FontSize="11.5" VerticalAlignment="Center"/>
                </StackPanel>
              </Border>
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
      </DataGrid.Columns>
    </DataGrid>
    </Border>
  </DockPanel>
</UserControl>
