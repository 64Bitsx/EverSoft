<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:EverSoft.App.ViewModels"
             x:Class="EverSoft.App.Views.BoletimView"
             x:DataType="vm:BoletimVM">
  <DockPanel>
    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="12" Margin="0,0,0,16">
      <Border Width="46" Height="46" CornerRadius="14" Background="{DynamicResource Primaria}">
        <PathIcon Data="{StaticResource IcGrafico}" Width="22" Height="22" Foreground="{DynamicResource PrimariaTexto}"/>
      </Border>
      <StackPanel VerticalAlignment="Center" Spacing="2">
        <TextBlock Classes="titulo" Text="Boletim"/>
        <TextBlock Classes="subtitulo" Text="Aproveitamento do mês (primeira guia do Boletim.xlsm) e mensagens"/>
      </StackPanel>
    </StackPanel>
    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
      <TextBlock DockPanel.Dock="Right" Classes="subtitulo" Text="{Binding Resumo}" VerticalAlignment="Center"/>
      <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
        <Button Classes="primaria" Command="{Binding PuxarBoletinsCommand}"><StackPanel Orientation="Horizontal" Spacing="8"><PathIcon Data="{StaticResource IcBaixar}"/><TextBlock Text="Puxar boletins do dia"/></StackPanel></Button>
        <TextBlock Text="Mês:" VerticalAlignment="Center" FontWeight="SemiBold" Margin="12,0,0,0"/>
        <TextBox Text="{Binding MesAtual}" Width="120"/>
        <TextBlock Text="Próximo mês:" VerticalAlignment="Center" FontWeight="SemiBold"/>
        <TextBox Text="{Binding ProximoMes}" Width="120"/>
        <Button Content="Aplicar" Command="{Binding AplicarCommand}"/>
      </StackPanel>
    </DockPanel>
    <Border Classes="cartao" Padding="0" ClipToBounds="True">
    <DataGrid ItemsSource="{Binding Itens}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column">
      <DataGrid.Columns>
        <DataGridTextColumn x:DataType="vm:LinhaBoletim" Header="NOME" Binding="{Binding Nome}" Width="1.5*"/>
        <DataGridTextColumn x:DataType="vm:LinhaBoletim" Header="NÚMERO" Binding="{Binding Numero}" Width="136"/>
        <DataGridTextColumn x:DataType="vm:LinhaBoletim" Header="APROVEITAMENTO" Binding="{Binding Aproveitamento}" Width="140"/>
        <DataGridTextColumn x:DataType="vm:LinhaBoletim" Header="MENSAGEM" Binding="{Binding Mensagem}" Width="4*"/>
      </DataGrid.Columns>
    </DataGrid>
    </Border>
  </DockPanel>
</UserControl>
