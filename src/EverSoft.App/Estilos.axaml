<!-- Visual do EverSoft V3: cores do tema claro e do escuro + estilos dos controles.
     Use sempre {DynamicResource Nome} para a cor acompanhar a troca de tema. -->
<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Styles.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://EverSoft/Icones.axaml"/>
      </ResourceDictionary.MergedDictionaries>
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
          <SolidColorBrush x:Key="Fundo" Color="#F2F5FA"/>
          <SolidColorBrush x:Key="Superficie" Color="#FFFFFF"/>
          <SolidColorBrush x:Key="Superficie2" Color="#F6F8FC"/>
          <SolidColorBrush x:Key="Borda" Color="#E3E8F0"/>
          <SolidColorBrush x:Key="BordaForte" Color="#D3DBE6"/>
          <SolidColorBrush x:Key="Texto" Color="#0F172A"/>
          <SolidColorBrush x:Key="TextoSuave" Color="#64748B"/>
          <SolidColorBrush x:Key="Primaria" Color="#0D9488"/>
          <SolidColorBrush x:Key="PrimariaTexto" Color="#FFFFFF"/>
          <SolidColorBrush x:Key="PrimariaSuave" Color="#DDF5F1"/>
          <SolidColorBrush x:Key="Lateral" Color="#0B1B33"/>
          <SolidColorBrush x:Key="LateralBorda" Color="#16294A"/>
          <SolidColorBrush x:Key="LateralItemSel" Color="#16304F"/>
          <SolidColorBrush x:Key="CabecalhoGrade" Color="#F1F4F9"/>
          <SolidColorBrush x:Key="LinhaGrade" Color="#E8EDF4"/>
          <SolidColorBrush x:Key="LinhaHover" Color="#F4F7FB"/>
          <SolidColorBrush x:Key="LinhaSelecionada" Color="#E2E8F0"/>
          <SolidColorBrush x:Key="LinhaSemStatus" Color="#FED7AA"/>
          <SolidColorBrush x:Key="LinhaSemStatusSel" Color="#FDBA74"/>
          <SolidColorBrush x:Key="Botao" Color="#FFFFFF"/>
          <SolidColorBrush x:Key="BotaoHover" Color="#F1F5F9"/>
          <SolidColorBrush x:Key="Campo" Color="#F8FAFC"/>
          <SolidColorBrush x:Key="FotoFundo" Color="#E6EEF8"/>
          <SolidColorBrush x:Key="Sombra" Color="#1A0F172A"/>
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
          <SolidColorBrush x:Key="Fundo" Color="#0A1120"/>
          <SolidColorBrush x:Key="Superficie" Color="#111A2C"/>
          <SolidColorBrush x:Key="Superficie2" Color="#16213A"/>
          <SolidColorBrush x:Key="Borda" Color="#1F2C47"/>
          <SolidColorBrush x:Key="BordaForte" Color="#2A3A5C"/>
          <SolidColorBrush x:Key="Texto" Color="#E6EBF4"/>
          <SolidColorBrush x:Key="TextoSuave" Color="#8E9BB3"/>
          <SolidColorBrush x:Key="Primaria" Color="#2DD4BF"/>
          <SolidColorBrush x:Key="PrimariaTexto" Color="#042F2E"/>
          <SolidColorBrush x:Key="PrimariaSuave" Color="#123B3A"/>
          <SolidColorBrush x:Key="Lateral" Color="#070D19"/>
          <SolidColorBrush x:Key="LateralBorda" Color="#141F36"/>
          <SolidColorBrush x:Key="LateralItemSel" Color="#132A3F"/>
          <SolidColorBrush x:Key="CabecalhoGrade" Color="#16213A"/>
          <SolidColorBrush x:Key="LinhaGrade" Color="#1C2842"/>
          <SolidColorBrush x:Key="LinhaHover" Color="#18233B"/>
          <SolidColorBrush x:Key="LinhaSelecionada" Color="#22314F"/>
          <SolidColorBrush x:Key="LinhaSemStatus" Color="#5A2A0E"/>
          <SolidColorBrush x:Key="LinhaSemStatusSel" Color="#7A3A12"/>
          <SolidColorBrush x:Key="Botao" Color="#18233A"/>
          <SolidColorBrush x:Key="BotaoHover" Color="#1F2D4A"/>
          <SolidColorBrush x:Key="Campo" Color="#0E1628"/>
          <SolidColorBrush x:Key="FotoFundo" Color="#18243D"/>
          <SolidColorBrush x:Key="Sombra" Color="#66000000"/>
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>
      <!-- Cores que valem nos dois temas -->
      <SolidColorBrush x:Key="Verde" Color="#16A34A"/>
      <SolidColorBrush x:Key="Dourado" Color="#F59E0B"/>
      <SolidColorBrush x:Key="Laranja" Color="#EA580C"/>
      <SolidColorBrush x:Key="Vermelho" Color="#E5383B"/>
      <SolidColorBrush x:Key="Azul" Color="#2563EB"/>
      <SolidColorBrush x:Key="Roxo" Color="#7C3AED"/>
      <SolidColorBrush x:Key="Navy" Color="#0B1B33"/>
      <!-- A ordenação das colunas está desligada: não precisa reservar espaço para a setinha -->
      <x:Double x:Key="DataGridSortIconMinWidth">0</x:Double>
    </ResourceDictionary>
  </Styles.Resources>

  <Style Selector="Window">
    <Setter Property="Background" Value="{DynamicResource Fundo}"/>
    <Setter Property="Foreground" Value="{DynamicResource Texto}"/>
  </Style>

  <!-- Cartão com borda suave e sombra -->
  <Style Selector="Border.cartao">
    <Setter Property="Background" Value="{DynamicResource Superficie}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource Borda}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="14"/>
    <Setter Property="Padding" Value="16"/>
    <Setter Property="BoxShadow" Value="0 2 10 0 #140F172A"/>
  </Style>

  <Style Selector="TextBlock.titulo">
    <Setter Property="FontSize" Value="24"/>
    <Setter Property="FontWeight" Value="Bold"/>
    <Setter Property="Foreground" Value="{DynamicResource Texto}"/>
  </Style>
  <Style Selector="TextBlock.subtitulo">
    <Setter Property="FontSize" Value="12.5"/>
    <Setter Property="Foreground" Value="{DynamicResource TextoSuave}"/>
  </Style>
  <Style Selector="TextBlock.rotulo">
    <Setter Property="FontSize" Value="10.5"/>
    <Setter Property="FontWeight" Value="Bold"/>
    <Setter Property="LetterSpacing" Value="0.6"/>
    <Setter Property="Foreground" Value="{DynamicResource TextoSuave}"/>
  </Style>

  <!-- Botões: neutro (borda), e coloridos -->
  <Style Selector="Button">
    <Setter Property="CornerRadius" Value="10"/>
    <Setter Property="Padding" Value="14,8"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Background" Value="{DynamicResource Botao}"/>
    <Setter Property="Foreground" Value="{DynamicResource Texto}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource Borda}"/>
    <Setter Property="BorderThickness" Value="1"/>
  </Style>
  <Style Selector="Button:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource BotaoHover}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource BordaForte}"/>
    <Setter Property="Foreground" Value="{DynamicResource Texto}"/>
  </Style>
  <Style Selector="Button PathIcon">
    <Setter Property="Width" Value="16"/>
    <Setter Property="Height" Value="16"/>
  </Style>
  <Style Selector="Button.primaria"><Setter Property="Background" Value="{DynamicResource Primaria}"/><Setter Property="Foreground" Value="{DynamicResource PrimariaTexto}"/><Setter Property="BorderThickness" Value="0"/></Style>
  <Style Selector="Button.azul"><Setter Property="Background" Value="{StaticResource Azul}"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderThickness" Value="0"/></Style>
  <Style Selector="Button.verde"><Setter Property="Background" Value="{StaticResource Verde}"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderThickness" Value="0"/></Style>
  <Style Selector="Button.dourado"><Setter Property="Background" Value="{StaticResource Dourado}"/><Setter Property="Foreground" Value="#1E293B"/><Setter Property="BorderThickness" Value="0"/></Style>
  <Style Selector="Button.laranja"><Setter Property="Background" Value="{StaticResource Laranja}"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderThickness" Value="0"/></Style>
  <Style Selector="Button.vermelho"><Setter Property="Background" Value="{StaticResource Vermelho}"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderThickness" Value="0"/></Style>
  <Style Selector="Button.primaria:pointerover /template/ ContentPresenter, Button.azul:pointerover /template/ ContentPresenter, Button.verde:pointerover /template/ ContentPresenter, Button.dourado:pointerover /template/ ContentPresenter, Button.laranja:pointerover /template/ ContentPresenter, Button.vermelho:pointerover /template/ ContentPresenter">
    <Setter Property="Opacity" Value="0.88"/>
  </Style>
  <Style Selector="Button.primaria:pointerover /template/ ContentPresenter"><Setter Property="Background" Value="{DynamicResource Primaria}"/><Setter Property="Foreground" Value="{DynamicResource PrimariaTexto}"/></Style>
  <Style Selector="Button.azul:pointerover /template/ ContentPresenter"><Setter Property="Background" Value="{StaticResource Azul}"/><Setter Property="Foreground" Value="White"/></Style>
  <Style Selector="Button.verde:pointerover /template/ ContentPresenter"><Setter Property="Background" Value="{StaticResource Verde}"/><Setter Property="Foreground" Value="White"/></Style>
  <Style Selector="Button.dourado:pointerover /template/ ContentPresenter"><Setter Property="Background" Value="{StaticResource Dourado}"/><Setter Property="Foreground" Value="#1E293B"/></Style>
  <Style Selector="Button.laranja:pointerover /template/ ContentPresenter"><Setter Property="Background" Value="{StaticResource Laranja}"/><Setter Property="Foreground" Value="White"/></Style>
  <Style Selector="Button.vermelho:pointerover /template/ ContentPresenter"><Setter Property="Background" Value="{StaticResource Vermelho}"/><Setter Property="Foreground" Value="White"/></Style>

  <!-- Botões do menu lateral (fundo escuro) -->
  <Style Selector="Button.lateral">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Foreground" Value="#B8C4D9"/>
    <Setter Property="HorizontalAlignment" Value="Stretch"/>
    <Setter Property="HorizontalContentAlignment" Value="Left"/>
    <Setter Property="Padding" Value="12,7"/>
    <Setter Property="FontWeight" Value="Medium"/>
  </Style>
  <Style Selector="Button.lateral:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="#1A2D4D"/>
    <Setter Property="Foreground" Value="White"/>
    <Setter Property="BorderThickness" Value="0"/>
  </Style>

  <!-- Menu lateral: itens grandes, a aba aberta fica com fundo e uma barra verde-água à esquerda -->
  <Style Selector="ListBox.menu">
    <Setter Property="Background" Value="Transparent"/>
  </Style>
  <Style Selector="ListBox.menu ListBoxItem">
    <Setter Property="Padding" Value="0"/>
    <Setter Property="Margin" Value="0,1"/>
    <Setter Property="Foreground" Value="#B8C4D9"/>
  </Style>
  <Style Selector="ListBox.menu ListBoxItem /template/ ContentPresenter">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="CornerRadius" Value="10"/>
  </Style>
  <Style Selector="ListBox.menu ListBoxItem:pointerover /template/ ContentPresenter, ListBox.menu ListBoxItem:selected /template/ ContentPresenter">
    <Setter Property="Background" Value="Transparent"/>
  </Style>
  <Style Selector="ListBox.menu ListBoxItem:pointerover Border.item">
    <Setter Property="Background" Value="#11223B"/>
  </Style>
  <Style Selector="ListBox.menu ListBoxItem:selected Border.item">
    <Setter Property="Background" Value="{DynamicResource LateralItemSel}"/>
  </Style>
  <Style Selector="ListBox.menu ListBoxItem:selected /template/ ContentPresenter, ListBox.menu ListBoxItem:pointerover /template/ ContentPresenter">
    <Setter Property="Foreground" Value="White"/>
  </Style>
  <Style Selector="ListBox.menu ListBoxItem Border.marcador">
    <Setter Property="Background" Value="Transparent"/>
  </Style>
  <Style Selector="ListBox.menu ListBoxItem:selected Border.marcador">
    <Setter Property="Background" Value="#2DD4BF"/>
  </Style>
  <Style Selector="ListBox.menu ListBoxItem TextBlock.menutitulo">
    <Setter Property="FontWeight" Value="SemiBold"/>
  </Style>
  <Style Selector="ListBox.menu ListBoxItem:selected TextBlock.menutitulo">
    <Setter Property="FontWeight" Value="Bold"/>
  </Style>

  <!-- Campos -->
  <Style Selector="TextBox">
    <Setter Property="CornerRadius" Value="8"/>
  </Style>
  <Style Selector="ComboBox">
    <Setter Property="CornerRadius" Value="8"/>
  </Style>

  <!-- Tabelas -->
  <Style Selector="DataGrid">
    <Setter Property="Background" Value="{DynamicResource Superficie}"/>
    <Setter Property="RowBackground" Value="Transparent"/>
    <Setter Property="GridLinesVisibility" Value="All"/>
    <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource LinhaGrade}"/>
    <Setter Property="VerticalGridLinesBrush" Value="{DynamicResource LinhaGrade}"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="Foreground" Value="{DynamicResource Texto}"/>
  </Style>
  <Style Selector="DataGridColumnHeader">
    <Setter Property="Background" Value="{DynamicResource CabecalhoGrade}"/>
    <Setter Property="Foreground" Value="{DynamicResource TextoSuave}"/>
    <Setter Property="FontSize" Value="10.5"/>
    <Setter Property="FontWeight" Value="Bold"/>
    <Setter Property="Padding" Value="10,0,0,0"/>
    <Setter Property="MinHeight" Value="38"/>
    <Setter Property="SeparatorBrush" Value="{DynamicResource LinhaGrade}"/>
  </Style>
  <Style Selector="DataGridCell">
    <Setter Property="Padding" Value="4,0"/>
  </Style>
  <Style Selector="DataGridRow:pointerover /template/ Rectangle#BackgroundRectangle">
    <Setter Property="Fill" Value="{DynamicResource LinhaHover}"/>
    <Setter Property="Opacity" Value="1"/>
  </Style>
  <!-- Linha selecionada: cinza-claro (escuro no tema escuro), texto normal -->
  <Style Selector="DataGridRow:selected /template/ Rectangle#BackgroundRectangle">
    <Setter Property="Fill" Value="{DynamicResource LinhaSelecionada}"/>
    <Setter Property="Opacity" Value="1"/>
  </Style>
  <Style Selector="DataGridRow:selected">
    <Setter Property="Foreground" Value="{DynamicResource Texto}"/>
  </Style>
  <Style Selector="DataGridCell:current /template/ Grid#FocusVisual">
    <Setter Property="IsVisible" Value="False"/>
  </Style>

  <!-- Pílula de status -->
  <Style Selector="Border.pilula">
    <Setter Property="CornerRadius" Value="999"/>
    <Setter Property="Padding" Value="10,2"/>
    <Setter Property="Margin" Value="6,5"/>
  </Style>
</Styles>
